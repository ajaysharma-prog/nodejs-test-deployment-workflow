{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",

    "sourceMap": true,
    "types": ["node", "aws-lambda"],
    // Recommended Options
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
