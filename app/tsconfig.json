{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "es2024",
    "moduleResolution": "nodenext",

    "sourceMap": true,
    "types": ["node", "aws-lambda"],

    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
